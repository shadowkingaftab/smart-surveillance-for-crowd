APP_ENV=development
LOG_LEVEL=INFO
# Testing/demo mode: runs the full pipeline with a synthetic detector/pose/face
# layer instead of real models, so the system can be smoke-tested end-to-end
# offline (no GPU, no model weights, no camera hardware required).
DEMO_MODE=false
DATABASE_URL=sqlite:///./data/ivi.db
# Production example:
# DATABASE_URL=postgresql+psycopg://ivi:change_me@localhost:5432/ivi

# --- Legacy single-camera mode (run.py) -----------------------------------------
CAMERA_ID=CAM-01
CAMERA_NAME=Local Camera
VIDEO_SOURCE=0

# --- Multi-camera mode (run_multi.py) -------------------------------------------
# Path to a YAML file listing multiple cameras; see config/cameras.example.yaml.
# Leave blank to fall back to the single legacy camera above.
CAMERAS_CONFIG=config/cameras.example.yaml

TARGET_FPS=15
DETECTION_INTERVAL=1
POSE_INTERVAL=2
FACE_INTERVAL=15
EVENT_PRE_SECONDS=10
EVENT_POST_SECONDS=20
EVENT_COOLDOWN_SECONDS=10
MIN_DETECTION_CONF=0.35
MIN_TRACK_CONF=0.35
MIN_FACE_SIZE=64
SHOW_ALL_LABELS=true
ENABLE_FACE_ANALYSIS=true
ENABLE_POSE=true
ENABLE_ALERTS=false
ALERT_WEBHOOK_URL=
MODEL_DETECTOR=yolo11n.pt
MODEL_POSE=yolo11n-pose.pt

# --- Performance / resource controls ---------------------------------------------
FRAME_QUEUE_SIZE=4
RESULT_QUEUE_SIZE=8
MAX_RECONNECT_BACKOFF=30
RECONNECT_INITIAL_BACKOFF=1
STATUS_LOG_INTERVAL_SECONDS=15
GC_INTERVAL_SECONDS=60

# --- Privacy / retention ----------------------------------------------------------
SAVE_EVENT_CLIPS=true
OBSERVATION_RETENTION_DAYS=7
INCIDENT_RETENTION_DAYS=90
EVIDENCE_RETENTION_DAYS=30

# --- Cross-camera re-identification (candidate-linking only, never a claimed match)
ENABLE_CROSS_CAMERA_REID=true
REID_MATCH_WINDOW_SECONDS=6
REID_SIMILARITY_THRESHOLD=0.78

# --- Crowd anomaly baseline --------------------------------------------------------
CROWD_BASELINE_WINDOW=120
CROWD_ANOMALY_RATIO=2.2
CROWD_ANOMALY_MIN_COUNT=6
